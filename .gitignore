# Ignore environment files containing secrets
.env
.env.*
# ...pero la plantilla si se versiona. Sin esta excepcion, `.env.*` hace match
# con `.env.example` y git lo ignora en silencio: nadie se entera de que falta.
!.env.example

# Entorno local
.venv/
__pycache__/
*.pyc

# Herramientas de desarrollo
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Cache de respuestas del modelo (Settings.cache_dir). Es derivable: se
# reconstruye llamando a la API. Lo que SI se versiona son los outputs
# guardados en evals/resultados/, que son el registro de una medicion.
.cache/

# Secretos de Streamlit (la interfaz web). El tema, .streamlit/config.toml, si se versiona.
.streamlit/secrets.toml
